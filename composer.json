{
    "name": "anay/oddeven-checker",
    "description": "Prints odd/even based on sum of integer params",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Anay\\OddEvenChecker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
                "providers": [
                    "Anay\\OddEvenChecker\\OddEvenServiceProvider"
                ],
                "aliases": {
                    "OddEven": "Anay\\OddEvenChecker\\Facades\\OddEven"
                }
            }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0"
    }
}
