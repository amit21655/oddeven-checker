            "Anay\\OddEvenChecker\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anay\\OddEvenChecker\\OddEvenServiceProvider"
            ],
